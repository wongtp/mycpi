KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# https://data.bls.gov/registrationEngine/ — optional, but an unregistered
# request is capped at a much lower daily quota.
BLS_API_KEY=

# libpq environment variables: psycopg.connect() is called with no arguments
# and reads the connection details from here.
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
# require / verify-full for a hosted database; omit it locally.
PGSSLMODE=
